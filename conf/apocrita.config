/*
 * Apocrita HPC (QMUL) Configuration
 * Usage: nextflow run main.nf -profile apocrita,apptainer
 *
 * Work directory: /gpfs/scratch/$USER/lncrna_work (3TB quota, 65-day auto-cleanup)
 */

includeConfig 'slurm.config'

workDir = "/gpfs/scratch/${System.getenv('USER')}/lncrna_work"

params {
    slurm_queue   = null
    slurm_account = 'pilot'
}

process {
    scratch = "/gpfs/scratch/${System.getenv('USER')}/lncrna_tmp"

    withLabel: 'process_single' {
        cpus   = 1
        memory = { 6.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = { 12.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 6
        memory = { 24.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = 12
        memory = { 48.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }
    withLabel: 'process_long' {
        time   = { 24.h * task.attempt }
    }
    withLabel: 'process_high_memory' {
        memory = { 96.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
}

apptainer.cacheDir    = "/gpfs/scratch/${System.getenv('USER')}/apptainer_cache"
docker.enabled        = false
podman.enabled        = false

env {
    APPTAINER_CACHEDIR   = "/gpfs/scratch/${System.getenv('USER')}/apptainer_cache"
    CONDA_PKGS_DIRS       = "/gpfs/scratch/${System.getenv('USER')}/conda_pkgs"
    PYTHONNOUSERSITE     = 1
    R_PROFILE_USER       = "/.Rprofile"
    R_ENVIRON_USER       = "/.Renviron"
}

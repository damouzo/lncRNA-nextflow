process {
    errorStrategy = 'retry'
    maxRetries    = 2
    maxErrors     = '-1'

    // Defaults — override per-module in modules.config
    cpus   = 1
    memory = 4.GB
    time   = 2.h

    withLabel: small_task {
        cpus   = 1
        memory = 2.GB
        time   = 1.h
    }

    withLabel: medium_task {
        cpus   = 4
        memory = 16.GB
        time   = 6.h
    }

    withLabel: large_task {
        cpus   = 8
        memory = 48.GB
        time   = 24.h
    }

    withLabel: huge_task {
        cpus   = 16
        memory = 96.GB
        time   = 48.h
    }
}

env {
    TMPDIR = "${workDir}/tmp"
}

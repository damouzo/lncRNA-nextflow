process {
    errorStrategy = 'retry'
    maxRetries    = 2
    maxErrors     = '-1'

    cpus   = 1
    memory = 4.GB
    time   = 2.h

    withLabel: 'process_single' {
        cpus   = 1
        memory = 2.GB
        time   = 1.h
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = 8.GB
        time   = 4.h
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = 16.GB
        time   = 6.h
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = 48.GB
        time   = 24.h
    }
    withLabel: 'process_long' {
        time   = 48.h
    }
    withLabel: 'process_high_memory' {
        memory = 96.GB
        time   = 24.h
    }
}

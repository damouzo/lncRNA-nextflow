process {

    // ---- Phase A modules ----

    withName: BAM_QUICKCHECK {
        label       = 'small_task'
        publishDir  = [
            path: { "${params.outdir}/phase_a/01_bam_validation" },
            mode: params.publish_dir_mode
        ]
    }

    withName: INFER_STRANDEDNESS {
        label       = 'small_task'
        publishDir  = [
            path: { "${params.outdir}/phase_a/02_strandedness" },
            mode: params.publish_dir_mode
        ]
    }

    withName: STRINGTIE2_PER_SAMPLE {
        label       = 'medium_task'
        cpus        = 8
        publishDir  = [
            path: { "${params.outdir}/phase_a/03_stringtie" },
            mode: params.publish_dir_mode,
            pattern: '*transcripts.gtf'
        ]
    }

    withName: STRINGTIE2_MERGE {
        label       = 'medium_task'
        publishDir  = [
            path: { "${params.outdir}/phase_a/04_stringtie_merge" },
            mode: params.publish_dir_mode
        ]
    }

    withName: GFFCOMPARE {
        label       = 'medium_task'
        publishDir  = [
            path: { "${params.outdir}/phase_a/05_gffcompare" },
            mode: params.publish_dir_mode
        ]
    }

    withName: TRANSCRIPT_LENGTH_FILTER {
        label       = 'small_task'
        publishDir  = [
            path: { "${params.outdir}/phase_a/06_length_filter" },
            mode: params.publish_dir_mode
        ]
    }

    withName: CPAT_BUILD_MODEL {
        label       = 'large_task'
        cpus        = 8
        memory      = 32.GB
        publishDir  = [
            path: { "${params.outdir}/phase_a/07_cpat_models" },
            mode: params.publish_dir_mode
        ]
    }

    withName: CPAT {
        label       = 'medium_task'
        publishDir  = [
            path: { "${params.outdir}/phase_a/07_cpat" },
            mode: params.publish_dir_mode
        ]
    }

    withName: CPC2 {
        label       = 'medium_task'
        publishDir  = [
            path: { "${params.outdir}/phase_a/08_cpc2" },
            mode: params.publish_dir_mode
        ]
    }

    withName: CODING_CONSENSUS {
        label       = 'small_task'
        publishDir  = [
            path: { "${params.outdir}/phase_a/09_coding_consensus" },
            mode: params.publish_dir_mode
        ]
    }

    withName: CATALOG_OVERLAP {
        label       = 'small_task'
        publishDir  = [
            path: { "${params.outdir}/phase_a/10_catalog_overlap" },
            mode: params.publish_dir_mode
        ]
    }

    withName: FEATURECOUNTS_EXPRESSION {
        label       = 'medium_task'
        cpus        = 8
        memory      = 16.GB
        publishDir  = [
            path: { "${params.outdir}/phase_a/11_featurecounts" },
            mode: params.publish_dir_mode
        ]
    }

    withName: EXPRESSION_RECURRENCE {
        label       = 'small_task'
        publishDir  = [
            path: { "${params.outdir}/phase_a/11_recurrence" },
            mode: params.publish_dir_mode
        ]
    }

    withName: ANNOTATION_FREEZE {
        label       = 'small_task'
        publishDir  = [
            path: { "${params.outdir}/phase_a/12_frozen" },
            mode: params.publish_dir_mode
        ]
    }

    // ---- Phase B modules ----

    withName: BUILD_DECOY_INDEX {
        label       = 'large_task'
        cpus        = 12
        publishDir  = [
            path: { "${params.outdir}/phase_b/01_decoy_index" },
            mode: params.publish_dir_mode
        ]
    }

    withName: SALMON_QUANTIFY {
        label       = 'large_task'
        cpus        = 8
        publishDir  = [
            path: { "${params.outdir}/phase_b/02_salmon_quant" },
            mode: params.publish_dir_mode
        ]
    }

    withName: DESEQ2_DE {
        label       = 'medium_task'
        publishDir  = [
            path: { "${params.outdir}/phase_b/03_deseq2" },
            mode: params.publish_dir_mode
        ]
    }

    withName: CIS_ASSOCIATIONS {
        label       = 'medium_task'
        publishDir  = [
            path: { "${params.outdir}/phase_b/04_cis_assoc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: FUNCTIONAL_ENRICHMENT {
        label       = 'medium_task'
        publishDir  = [
            path: { "${params.outdir}/phase_b/05_enrichment" },
            mode: params.publish_dir_mode
        ]
    }

    withName: QC_REPORT {
        label       = 'medium_task'
        publishDir  = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode
        ]
    }
}

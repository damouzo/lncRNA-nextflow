/*
 * Output tree (see "Mapa de publicación" in .kilo/plans/lncrna_plan_v3.md).
 *
 * publish_level = core | core_raw | full (default core_raw):
 *   core     -> deliverables/ only
 *   core_raw -> deliverables/ + raw/ + run_info/
 *   full     -> the above plus heavy audit outputs (bam_validation)
 *
 * raw/ holds native outputs named by function (no "f1"); run_info/ holds audit
 * metadata; deliverables/ holds the shippable contract.
 */
process {

    // ---- Discovery ----

    withName: BAM_QUICKCHECK {
        label       = 'process_single'
        // Audit-only: the validated BAMs stay in the work dir (multi-GB) and only
        // the tiny quickcheck logs are published, and only at publish_level=full.
        publishDir  = [
            path: { "${params.outdir}/raw/bam_validation" },
            mode: params.publish_dir_mode,
            pattern: '*.quickcheck.log',
            enabled: { params.publish_level == 'full' }
        ]
    }

    withName: BUILD_INFER_BED {
        label       = 'process_single'
        // Whole-GTF import into a GRanges; leave headroom and let OOM retries escalate.
        memory      = { 24.GB * task.attempt }
        publishDir  = [
            path: { "${params.outdir}/raw/strandedness_bed" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: INFER_STRANDEDNESS {
        label       = 'process_low'
        cpus        = 1
        memory      = 4.GB
        publishDir  = [
            path: { "${params.outdir}/raw/strandedness" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: CHECK_STRANDEDNESS {
        label       = 'process_single'
        memory      = 4.GB
        publishDir  = [
            path: { "${params.outdir}/run_info" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: CHECK_SALMON_LIBTYPE {
        label         = 'process_single'
        memory        = 4.GB
        // Abort the run on the first bad sample instead of finishing all 50.
        errorStrategy = 'terminate'
    }

    // ---- F1 flags (Phase A, terminal) ----

    withName: BUILD_F1_REGIONS {
        label      = 'process_single'
        memory     = { 8.GB * task.attempt }
        publishDir = [
            path: { "${params.outdir}/raw/f1_regions" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: FLANK_COUNTS {
        label = 'process_low'
    }

    withName: ANTISENSE_COUNTS {
        label = 'process_low'
    }

    withName: FLANK_COVERAGE_RATIO {
        label      = 'process_single'
        publishDir = [
            path: { "${params.outdir}/raw/flank_metrics" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: FLAG_ANTISENSE_LEAKAGE {
        label      = 'process_single'
        publishDir = [
            path: { "${params.outdir}/raw/antisense_metrics" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: DERIVE_THRESHOLDS {
        label      = 'process_single'
        publishDir = [
            path: { "${params.outdir}/run_info" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: COMPUTE_TIER_FINAL {
        label      = 'process_single'
        memory     = 4.GB
        publishDir = [
            [
                path: { "${params.outdir}/raw/tier_final" },
                mode: params.publish_dir_mode,
                enabled: { params.publish_level in ['core_raw', 'full'] }
            ],
            [
                // F1.6 tables are part of the catalog deliverable.
                path: { "${params.outdir}/deliverables/catalog" },
                mode: params.publish_dir_mode,
                pattern: '{tier_final_by_class.tsv,tier_final_sensitivity.tsv}',
                enabled: true
            ]
        ]
    }

    withName: STRINGTIE2_PER_SAMPLE {
        label       = 'process_high'
        cpus        = 12
        memory      = 36.GB
        publishDir  = [
            path: { "${params.outdir}/raw/stringtie" },
            mode: params.publish_dir_mode,
            pattern: '*transcripts.gtf',
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: STRINGTIE2_MERGE {
        label       = 'process_medium'
        memory      = 64.GB
        publishDir  = [
            path: { "${params.outdir}/raw/stringtie_merge" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: GFFCOMPARE {
        label       = 'process_medium'
        publishDir  = [
            path: { "${params.outdir}/raw/gffcompare" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: TRANSCRIPT_LENGTH_FILTER {
        label       = 'process_single'
        publishDir  = [
            path: { "${params.outdir}/raw/length_filter" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: CPAT_BUILD_MODEL {
        label       = 'process_high'
        cpus        = 8
        memory      = 32.GB
        publishDir  = [
            path: { "${params.outdir}/raw/cpat_models" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: CPAT {
        label       = 'process_medium'
        memory      = 32.GB
        publishDir  = [
            path: { "${params.outdir}/raw/cpat" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: CPC2 {
        label       = 'process_medium'
        memory      = 32.GB
        publishDir  = [
            path: { "${params.outdir}/raw/cpc2" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: CODING_CONSENSUS {
        label       = 'process_single'
        publishDir  = [
            path: { "${params.outdir}/raw/coding_consensus" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: CATALOG_OVERLAP {
        label       = 'process_single'
        publishDir  = [
            path: { "${params.outdir}/raw/catalog_overlap" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: FEATURECOUNTS_EXPRESSION {
        label       = 'process_medium'
        cpus        = 8
        memory      = 32.GB
        publishDir  = [
            path: { "${params.outdir}/raw/featurecounts" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: EXPRESSION_RECURRENCE {
        label       = 'process_single'
        memory      = 12.GB
        publishDir  = [
            path: { "${params.outdir}/raw/expression_recurrence" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: ANNOTATION_FREEZE {
        label       = 'process_single'
        publishDir  = [
            path: { "${params.outdir}/raw/annotation_freeze" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: BUILD_GENE_CATALOG {
        label       = 'process_single'
        memory      = 16.GB
        publishDir  = [
            path: { "${params.outdir}/raw/gene_catalog" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: ASSIGN_CATALOG_IDS {
        label       = 'process_medium'
        memory      = 24.GB
        publishDir  = [
            path: { "${params.outdir}/raw/catalog_ids" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: BUILD_CATALOG_MASTER {
        label       = 'process_single'
        memory      = 16.GB
        publishDir  = [
            path: { "${params.outdir}/raw/catalog_master" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: CHECK_REFERENCE_COMPATIBILITY {
        label       = 'process_single'
        memory      = 2.GB
        publishDir  = [
            path: { "${params.outdir}/raw/reference_compatibility" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: CONSERVATION_SCORE {
        label       = 'process_medium'
        memory      = 16.GB
        publishDir  = [
            path: { "${params.outdir}/raw/conservation" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: SYNTENY_CHECK {
        label       = 'process_medium'
        memory      = 12.GB
        publishDir  = [
            path: { "${params.outdir}/raw/synteny" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    // ---- Deliverables (Slice B/C) ----

    withName: PUBLISH_CATALOG {
        label       = 'process_single'
        memory      = 8.GB
        publishDir  = [
            path: { "${params.outdir}/deliverables/catalog" },
            mode: params.publish_dir_mode
        ]
    }

    withName: PUBLISH_RUN_INFO {
        label       = 'process_single'
        memory      = 4.GB
        publishDir  = [
            [
                // Generated deliverables README -> deliverables/README.md
                path: { "${params.outdir}/deliverables" },
                mode: params.publish_dir_mode,
                pattern: '__deliverables_README.md',
                saveAs: 'README.md'
            ],
            [
                path: { "${params.outdir}/deliverables/run_info" },
                mode: params.publish_dir_mode,
                pattern: '__run_info_README.md',
                saveAs: 'README.md'
            ],
            [
                path: { "${params.outdir}/deliverables/run_info" },
                mode: params.publish_dir_mode,
                pattern: '{versions.tsv,sample_index.tsv,qa_report.tsv}'
            ],
            [
                // Raw audit set stays at the top-level run_info/.
                path: { "${params.outdir}/run_info" },
                mode: params.publish_dir_mode,
                pattern: '{params_used.tsv,run_manifest.tsv,external_catalogs.tsv}',
                enabled: { params.publish_level in ['core_raw', 'full'] }
            ]
        ]
    }

    // ---- Quantification ----

    withName: SPLIT_BY_NORMGROUP {
        label       = 'process_single'
        publishDir  = [
            path: { "${params.outdir}/raw/per_group_coldata" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: BUILD_DECOY_INDEX {
        label       = 'process_high'
        cpus        = 12
        memory      = 96.GB
        publishDir  = [
            path: { "${params.outdir}/raw/decoy_index" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: SALMON_QUANTIFY {
        label       = 'process_high'
        cpus        = 8
        memory      = 48.GB
        publishDir  = [
            path: { "${params.outdir}/raw/salmon_quant" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: TXIMPORT_AND_FILTER {
        label       = 'process_medium'
        memory      = 16.GB
        publishDir  = [
            path: { "${params.outdir}/raw/tximport_filter" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: DESEQ2_DE {
        label       = 'process_medium'
        memory      = 24.GB
        publishDir  = [
            path: { "${params.outdir}/raw/deseq2" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: CIS_ASSOCIATIONS {
        label       = 'process_medium'
        memory      = 16.GB
        publishDir  = [
            path: { "${params.outdir}/raw/cis_associations" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: FUNCTIONAL_ENRICHMENT {
        label       = 'process_medium'
        memory      = 16.GB
        publishDir  = [
            path: { "${params.outdir}/raw/enrichment" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: HETEROGENEITY_ANALYSIS {
        label       = 'process_medium'
        memory      = 16.GB
        publishDir  = [
            path: { "${params.outdir}/raw/heterogeneity" },
            mode: params.publish_dir_mode,
            enabled: { params.publish_level in ['core_raw', 'full'] }
        ]
    }

    withName: REPORT_CONTRAST {
        label       = 'process_low'
        memory      = 8.GB
        // Provisional flat location. Slice D reshapes this into
        // deliverables/contrasts/<grupo>__<contraste>/ (see Mapa de publicación).
        publishDir  = [
            path: { "${params.outdir}/deliverables/contrasts" },
            mode: params.publish_dir_mode
        ]
    }

}

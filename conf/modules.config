process {

    withName: BAM_QUICKCHECK {
        label       = 'process_single'
        publishDir  = [
            path: { "${params.outdir}/discovery/bam_validation" },
            mode: params.publish_dir_mode
        ]
    }

    withName: INFER_STRANDEDNESS {
        label       = 'process_low'
        publishDir  = [
            path: { "${params.outdir}/discovery/strandedness" },
            mode: params.publish_dir_mode
        ]
    }

    withName: STRINGTIE2_PER_SAMPLE {
        label       = 'process_high'
        cpus        = 8
        publishDir  = [
            path: { "${params.outdir}/discovery/stringtie" },
            mode: params.publish_dir_mode,
            pattern: '*transcripts.gtf'
        ]
    }

    withName: STRINGTIE2_MERGE {
        label       = 'process_medium'
        memory      = 32.GB
        publishDir  = [
            path: { "${params.outdir}/discovery/stringtie_merge" },
            mode: params.publish_dir_mode
        ]
    }

    withName: GFFCOMPARE {
        label       = 'process_medium'
        publishDir  = [
            path: { "${params.outdir}/discovery/gffcompare" },
            mode: params.publish_dir_mode
        ]
    }

    withName: TRANSCRIPT_LENGTH_FILTER {
        label       = 'process_single'
        publishDir  = [
            path: { "${params.outdir}/discovery/length_filter" },
            mode: params.publish_dir_mode
        ]
    }

    withName: CPAT_BUILD_MODEL {
        label       = 'process_high'
        cpus        = 8
        memory      = 32.GB
        publishDir  = [
            path: { "${params.outdir}/discovery/cpat_models" },
            mode: params.publish_dir_mode
        ]
    }

    withName: CPAT {
        label       = 'process_medium'
        publishDir  = [
            path: { "${params.outdir}/discovery/cpat" },
            mode: params.publish_dir_mode
        ]
    }

    withName: CPC2 {
        label       = 'process_medium'
        publishDir  = [
            path: { "${params.outdir}/discovery/cpc2" },
            mode: params.publish_dir_mode
        ]
    }

    withName: CODING_CONSENSUS {
        label       = 'process_single'
        publishDir  = [
            path: { "${params.outdir}/discovery/coding_consensus" },
            mode: params.publish_dir_mode
        ]
    }

    withName: CATALOG_OVERLAP {
        label       = 'process_single'
        publishDir  = [
            path: { "${params.outdir}/discovery/catalog_overlap" },
            mode: params.publish_dir_mode
        ]
    }

    withName: FEATURECOUNTS_EXPRESSION {
        label       = 'process_medium'
        cpus        = 8
        memory      = 16.GB
        publishDir  = [
            path: { "${params.outdir}/discovery/featurecounts" },
            mode: params.publish_dir_mode
        ]
    }

    withName: EXPRESSION_RECURRENCE {
        label       = 'process_single'
        publishDir  = [
            path: { "${params.outdir}/discovery/expression_recurrence" },
            mode: params.publish_dir_mode
        ]
    }

    withName: ANNOTATION_FREEZE {
        label       = 'process_single'
        publishDir  = [
            path: { "${params.outdir}/discovery/annotation_freeze" },
            mode: params.publish_dir_mode
        ]
    }

    // ---- Quantification ----

    withName: BUILD_DECOY_INDEX {
        label       = 'process_high'
        cpus        = 12
        publishDir  = [
            path: { "${params.outdir}/quantification/decoy_index" },
            mode: params.publish_dir_mode
        ]
    }

    withName: SALMON_QUANTIFY {
        label       = 'process_high'
        cpus        = 8
        publishDir  = [
            path: { "${params.outdir}/quantification/salmon_quant" },
            mode: params.publish_dir_mode
        ]
    }

    withName: TXIMPORT_AND_FILTER {
        label       = 'process_medium'
        publishDir  = [
            path: { "${params.outdir}/quantification/tximport_filter" },
            mode: params.publish_dir_mode
        ]
    }

    withName: DESEQ2_DE {
        label       = 'process_medium'
        publishDir  = [
            path: { "${params.outdir}/quantification/deseq2" },
            mode: params.publish_dir_mode
        ]
    }

    withName: CIS_ASSOCIATIONS {
        label       = 'process_medium'
        publishDir  = [
            path: { "${params.outdir}/quantification/cis_associations" },
            mode: params.publish_dir_mode
        ]
    }

    withName: FUNCTIONAL_ENRICHMENT {
        label       = 'process_medium'
        publishDir  = [
            path: { "${params.outdir}/quantification/enrichment" },
            mode: params.publish_dir_mode
        ]
    }

}

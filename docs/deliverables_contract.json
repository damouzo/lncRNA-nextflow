{
  "contract": "lncrna-deliverables",
  "version": "1.3",
  "description": "Machine-readable contract for the published deliverables (see 'Mapa de publicación' in .kilo/plans/lncrna_plan_v3.md). Validated by bin/validate_deliverables.py (stdlib only). `kind: table` entries list required columns (extras allowed) and a lower bound on rows; `file`/`gtf`/`fasta` entries only require the file to exist. Placeholders (`<id>`, `<group>`) are matched by glob, so one entry covers every contrast/group.",
  "files": [
    {
      "path": "README.md",
      "kind": "file",
      "description": "Generated from this contract by bin/build_deliverables_readme.py"
    },
    {
      "path": "catalog/catalog_genes.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "gene_id", "type": "string"},
        {"name": "origin", "type": "string"},
        {"name": "class_code", "type": "string"},
        {"name": "tier_static", "type": "bool"},
        {"name": "tier_final", "type": "bool"},
        {"name": "n_tier1_transcripts", "type": "int"},
        {"name": "single_exon_low_confidence", "type": "bool"},
        {"name": "antisense_status", "type": "string"},
        {"name": "lnc_position_class", "type": "string"}
      ]
    },
    {
      "path": "catalog/catalog_tx.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "transcript_id", "type": "string"},
        {"name": "gene_id", "type": "string"},
        {"name": "class_code", "type": "string"},
        {"name": "tier_static", "type": "bool"},
        {"name": "tier_final", "type": "bool"}
      ]
    },
    {
      "path": "catalog/candidates_all.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "transcript_id", "type": "string"},
        {"name": "class_code", "type": "string"},
        {"name": "length", "type": "int"},
        {"name": "filter_status", "type": "string"},
        {"name": "filter_reason", "type": "string"},
        {"name": "frozen", "type": "bool"}
      ]
    },
    {
      "path": "catalog/tier_final_by_class.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "tier1_allow_single_exon", "type": "bool"},
        {"name": "unit", "type": "string"},
        {"name": "class_set", "type": "string"},
        {"name": "n", "type": "int"}
      ]
    },
    {
      "path": "catalog/tier_final_sensitivity.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "changed", "type": "string"},
        {"name": "percentile", "type": "string"},
        {"name": "n_tier1_final_genes", "type": "int"}
      ]
    },
    {
      "path": "catalog/annotation/lncrna_catalog.gtf",
      "kind": "gtf",
      "description": "Frozen catalog GTF with LNC gene/transcript ids (BED12 intentionally not published)"
    },
    {
      "path": "catalog/annotation/lncrna_catalog.fa",
      "kind": "fasta",
      "description": "Catalog transcript sequences (gffread -w), ids = catalog_tx.tsv"
    },
    {
      "path": "contrasts/<id>/de_full.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "gene_id", "type": "string"},
        {"name": "contrast", "type": "string"},
        {"name": "baseMean", "type": "float"},
        {"name": "log2FoldChange", "type": "float"},
        {"name": "lfcSE", "type": "float"},
        {"name": "pvalue", "type": "float"},
        {"name": "padj", "type": "float"},
        {"name": "significant", "type": "bool"},
        {"name": "tested", "type": "bool"},
        {"name": "not_tested_reason", "type": "string"},
        {"name": "padj_na_reason", "type": "string"},
        {"name": "origin", "type": "string"},
        {"name": "class_code", "type": "string"},
        {"name": "tier_static", "type": "bool"},
        {"name": "tier_final", "type": "bool"},
        {"name": "antisense_status", "type": "string"}
      ]
    },
    {
      "path": "contrasts/<id>/de_significant.tsv",
      "kind": "table",
      "min_rows": 0,
      "columns": [
        {"name": "gene_id", "type": "string"},
        {"name": "log2FoldChange", "type": "float"},
        {"name": "padj", "type": "float"}
      ]
    },
    {
      "path": "contrasts/<id>/summary.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "contrast", "type": "string"},
        {"name": "n_universe", "type": "int"},
        {"name": "n_tested", "type": "int"},
        {"name": "n_significant", "type": "int"}
      ]
    },
    {
      "path": "contrasts/<id>/<id>_report.html",
      "kind": "file",
      "description": "Self-contained HTML report per contrast"
    },
    {
      "path": "groups/<group>/cis_pairs.tsv",
      "kind": "table",
      "min_rows": 0,
      "columns": []
    },
    {
      "path": "groups/<group>/cis_pairs_significant.tsv",
      "kind": "table",
      "min_rows": 0,
      "columns": []
    },
    {
      "path": "groups/<group>/cis_associations_summary.tsv",
      "kind": "table",
      "min_rows": 0,
      "columns": []
    },
    {
      "path": "groups/<group>/enrichment_ora.tsv",
      "kind": "table",
      "min_rows": 0,
      "columns": []
    },
    {
      "path": "groups/<group>/enrichment_gsea.tsv",
      "kind": "table",
      "min_rows": 0,
      "columns": []
    },
    {
      "path": "expression/<group>_counts.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "gene_id", "type": "string"}
      ]
    },
    {
      "path": "expression/<group>_tpm.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "gene_id", "type": "string"}
      ]
    },
    {
      "path": "expression/<group>_universe.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "gene_id", "type": "string"},
        {"name": "keep", "type": "bool"},
        {"name": "filter_status", "type": "string"},
        {"name": "filter_reason", "type": "string"}
      ]
    },
    {
      "path": "expression/sample_metadata.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "sample", "type": "string"},
        {"name": "norm_group", "type": "string"}
      ]
    },
    {
      "path": "plots/figures_manifest.tsv",
      "kind": "table",
      "min_rows": 0,
      "columns": []
    },
    {
      "path": "validation/recovery_reference.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "metric", "type": "string"},
        {"name": "value", "type": "string"}
      ]
    },
    {
      "path": "validation/tier1_vs_annotated.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "set", "type": "string"},
        {"name": "n_genes", "type": "int"},
        {"name": "n_expressed", "type": "int"},
        {"name": "fraction_expressed", "type": "string"},
        {"name": "mean_tpm", "type": "string"}
      ]
    },
    {
      "path": "run_info/versions.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "process", "type": "string"},
        {"name": "tool", "type": "string"},
        {"name": "version", "type": "string"},
        {"name": "container", "type": "string"}
      ]
    },
    {
      "path": "run_info/sample_index.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "sample", "type": "string"},
        {"name": "norm_group", "type": "string"}
      ]
    },
    {
      "path": "run_info/qa_report.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "metric", "type": "string"},
        {"name": "value", "type": "string"}
      ]
    }
  ]
}

        {"name": "rnacentral_best_pct", "type": "float"}
      ]
    },
    {
      "path": "contrasts/<id>/summary.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "contrast", "type": "string"},
        {"name": "n_universe", "type": "int"},
        {"name": "n_tested", "type": "int"},
        {"name": "n_significant", "type": "int"},
        {"name": "n_lncrna_full", "type": "int"},
        {"name": "n_lncrna_significant", "type": "int"}
      ]
    },
    {
      "path": "contrasts/<id>/<ct>_report.html",
      "kind": "file",
      "description": "Self-contained HTML report per contrast"
    },
    {
      "path": "contrasts/contrasts_overview.tsv",
      "kind": "table",
      "min_rows": 1,

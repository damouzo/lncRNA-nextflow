    {
      "path": "contrasts/<id>/enrichment_ora.tsv",
      "kind": "table",
      "min_rows": 0,
      "columns": []
    },
    {
      "path": "contrasts/<id>/enrichment_gsea.tsv",
      "kind": "table",
      "min_rows": 0,
      "columns": []
    },
    {
      "path": "contrasts/<id>/plots/volcano.pdf",
      "kind": "file",
      "optional": true,
      "description": "Volcano panel (all lncRNAs: annotated + novel) as a standalone PDF"
    },
    {
      "path": "contrasts/<id>/plots/volcano_annotated.pdf",
      "kind": "file",
      "optional": true,
      "description": "Volcano panel, annotated lncRNAs only (absent when none are tested)"
    },
    {
      "path": "contrasts/<id>/plots/volcano_novel.pdf",
      "kind": "file",
      "optional": true,
      "description": "Volcano panel, novel lncRNAs only (absent when none are tested)"
    },
    {
      "path": "contrasts/<id>/plots/ma.png",
      "kind": "file",
      "optional": true,
      "description": "MA panel as a standalone PNG (absent when the contrast has no DE data)"
    },
    {
      "path": "contrasts/<id>/plots/sig_genes_by_chromosome.pdf",
      "kind": "file",
      "optional": true,
      "description": "Significant genes per chromosome by gene_group + within-chromosome significance rate (absent without DE data)"
    },
    {
      "path": "contrasts/<id>/plots/sig_lncrna_position_class.pdf",
      "kind": "file",
      "optional": true,
      "description": "Significant lncRNAs by lnc_position_class and direction (absent without significant lncRNAs)"
    },
    {
      "path": "contrasts/<id>/plots/novel_catalog_overlap.pdf",
      "kind": "file",
      "optional": true,

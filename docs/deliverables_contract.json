{
  "contract": "lncrna-deliverables",
  "version": "1.6",
  "description": "Machine-readable contract for the published deliverables (see 'Mapa de publicación' in .kilo/plans/lncrna_plan_v3.md). Validated by bin/validate_deliverables.py (stdlib only). `kind: table` entries list required columns (extras allowed) and a lower bound on rows; `file`/`gtf`/`fasta` entries only require the file to exist. Placeholders (`<id>`, `<group>`) are matched by glob, so one entry covers every contrast/group.",
  "files": [
    {
      "path": "README.md",
      "kind": "file",
      "description": "Generated from this contract by bin/build_deliverables_readme.py"
    },
    {
      "path": "catalog/catalog_genes.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "gene_id", "type": "string"},
        {"name": "origin", "type": "string"},
        {"name": "class_code", "type": "string"},
        {"name": "tier", "type": "string"},
        {"name": "tier_static", "type": "bool"},
        {"name": "tier_final", "type": "bool"},
        {"name": "n_tier1_transcripts", "type": "int"},
        {"name": "single_exon_low_confidence", "type": "bool"},
        {"name": "antisense_status", "type": "string"},
        {"name": "lnc_position_class", "type": "string"},
        {"name": "gene_group", "type": "string"},
        {"name": "known_catalog_hit", "type": "bool"},
        {"name": "catalog_sources", "type": "string"},
        {"name": "novelty_class", "type": "string"},
        {"name": "n_tx_hit", "type": "int"},
        {"name": "n_tx", "type": "int"},
        {"name": "in_noncode", "type": "bool"},
        {"name": "noncode_best_id", "type": "string"},
        {"name": "noncode_best_pct", "type": "float"},
        {"name": "in_rnacentral", "type": "bool"},
        {"name": "rnacentral_best_id", "type": "string"},
        {"name": "rnacentral_best_pct", "type": "float"}
      ]
    },
    {
      "path": "catalog/catalog_tx.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "transcript_id", "type": "string"},
        {"name": "gene_id", "type": "string"},
        {"name": "class_code", "type": "string"},
        {"name": "tier", "type": "string"},
        {"name": "tier_static", "type": "bool"},
        {"name": "tier_final", "type": "bool"},
        {"name": "origin", "type": "string"},
        {"name": "gene_group", "type": "string"},
        {"name": "lnc_position_class", "type": "string"},
        {"name": "catalog_id", "type": "string"},
        {"name": "catalog_transcript_id", "type": "string"},
        {"name": "mstrg_transcript_id", "type": "string"},
        {"name": "closest_reference_transcript", "type": "string"}
      ]
    },
    {
      "path": "catalog/candidates_all.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "transcript_id", "type": "string"},
        {"name": "gene_id", "type": "string"},
        {"name": "class_code", "type": "string"},
        {"name": "length", "type": "int"},
        {"name": "filter_status", "type": "string"},
        {"name": "filter_reason", "type": "string"},
        {"name": "frozen", "type": "bool"},
        {"name": "catalog_id", "type": "string"},
        {"name": "origin", "type": "string"},
        {"name": "gene_group", "type": "string"},
        {"name": "tier", "type": "string"},
        {"name": "lnc_position_class", "type": "string"}
      ]
    },
    {
      "path": "catalog/novel_lncrnas.tsv",
      "kind": "table",
      "min_rows": 0,
      "columns": [
        {"name": "gene_id", "type": "string"},
        {"name": "origin", "type": "string"},
        {"name": "class_code", "type": "string"},
        {"name": "tier_final", "type": "bool"},
        {"name": "lnc_position_class", "type": "string"}
      ]
    },
    {
      "path": "catalog/tier_final_by_class.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "tier1_allow_single_exon", "type": "bool"},
        {"name": "unit", "type": "string"},
        {"name": "class_set", "type": "string"},
        {"name": "n", "type": "int"}
      ]
    },
    {
      "path": "catalog/validation/tier_final_sensitivity.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "changed", "type": "string"},
        {"name": "percentile", "type": "string"},
        {"name": "n_tier1_final_genes", "type": "int"}
      ]
    },
    {
      "path": "catalog/annotation/README.md",
      "kind": "file",
      "description": "What the annotation/ GTF and FASTA contain"
    },
    {
      "path": "catalog/annotation/lncrna_catalog.gtf",
      "kind": "gtf",
      "description": "Frozen catalog GTF with LNC gene/transcript ids (BED12 intentionally not published)"
    },
    {
      "path": "catalog/annotation/lncrna_catalog.fa",
      "kind": "fasta",
      "description": "Catalog transcript sequences (gffread -w), ids = catalog_tx.tsv"
    },
    {
      "path": "contrasts/<id>/de_full.tsv",
      "kind": "table",
      "min_rows": 1,
      "columns": [
        {"name": "gene_id", "type": "string"},
        {"name": "contrast", "type": "string"},
        {"name": "baseMean", "type": "float"},
        {"name": "log2FoldChange", "type": "float"},
        {"name": "lfcSE", "type": "float"},
        {"name": "pvalue", "type": "float"},
        {"name": "padj", "type": "float"},
        {"name": "stat", "type": "float"},
        {"name": "lfc_unshrunken", "type": "float"},
        {"name": "shrink_type", "type": "string"},
        {"name": "significant_padj", "type": "bool"},
        {"name": "significant_padj_lfc1", "type": "bool"},
        {"name": "tested", "type": "bool"},
        {"name": "not_tested_reason", "type": "string"},
        {"name": "padj_na_reason", "type": "string"},
        {"name": "origin", "type": "string"},
        {"name": "class_code", "type": "string"},
        {"name": "tier", "type": "string"},
        {"name": "tier_static", "type": "bool"},
        {"name": "tier_final", "type": "bool"},
        {"name": "single_exon_low_confidence", "type": "bool"},
        {"name": "gene_name", "type": "string"},
        {"name": "gene_biotype", "type": "string"},
        {"name": "catalog_id", "type": "string"},
        {"name": "locus", "type": "string"},
        {"name": "lnc_position_class", "type": "string"},
        {"name": "antisense_status", "type": "string"},
        {"name": "chr", "type": "string"},
        {"name": "start", "type": "int"},
        {"name": "end", "type": "int"},
        {"name": "strand", "type": "string"},
        {"name": "gene_id_stable", "type": "string"},
        {"name": "gene_group", "type": "string"},
        {"name": "contig_type", "type": "string"},
        {"name": "baseMean_extreme", "type": "bool"},
        {"name": "genome_build", "type": "string"},
        {"name": "known_catalog_hit", "type": "bool"},
        {"name": "catalog_sources", "type": "string"},
        {"name": "novelty_class", "type": "string"},
        {"name": "n_tx_hit", "type": "int"},
        {"name": "n_tx", "type": "int"},
        {"name": "in_noncode", "type": "bool"},
        {"name": "noncode_best_id", "type": "string"},
        {"name": "noncode_best_pct", "type": "float"},
        {"name": "in_rnacentral", "type": "bool"},
        {"name": "rnacentral_best_id", "type": "string"},
        {"name": "rnacentral_best_pct", "type": "float"}
      ]
    },
    {
      "path": "contrasts/<id>/de_lncrna_full.tsv",
      "kind": "table",
      "min_rows": 0,
      "columns": [
        {"name": "gene_id", "type": "string"},
        {"name": "gene_id_stable", "type": "string"},
        {"name": "contrast", "type": "string"},
        {"name": "padj", "type": "float"},
        {"name": "log2FoldChange", "type": "float"},
        {"name": "gene_group", "type": "string"},
        {"name": "class_code", "type": "string"},
        {"name": "tier", "type": "string"},
        {"name": "lnc_position_class", "type": "string"},
        {"name": "chr", "type": "string"},
        {"name": "start", "type": "int"},
        {"name": "end", "type": "int"},
        {"name": "strand", "type": "string"},
        {"name": "known_catalog_hit", "type": "bool"},
        {"name": "catalog_sources", "type": "string"},
        {"name": "novelty_class", "type": "string"},
        {"name": "n_tx_hit", "type": "int"},
        {"name": "n_tx", "type": "int"},
        {"name": "in_noncode", "type": "bool"},
        {"name": "noncode_best_id", "type": "string"},
        {"name": "noncode_best_pct", "type": "float"},
        {"name": "in_rnacentral", "type": "bool"},
        {"name": "rnacentral_best_id", "type": "string"},
        {"name": "rnacentral_best_pct", "type": "float"}
      ]
    },
    {
      "path": "contrasts/<id>/de_full_significant.tsv",
      "kind": "table",
      "min_rows": 0,
      "columns": [
        {"name": "gene_id", "type": "string"},
        {"name": "log2FoldChange", "type": "float"},
        {"name": "padj", "type": "float"},
        {"name": "known_catalog_hit", "type": "bool"},
        {"name": "catalog_sources", "type": "string"},
        {"name": "novelty_class", "type": "string"},
        {"name": "in_noncode", "type": "bool"},

        {"name": "class_code", "type": "string"},
        {"name": "tier_final", "type": "string"},
        {"name": "lnc_position_class", "type": "string"}
      ]
    },
    {
      "path": "catalog/lncrna_genes.tsv",
      "kind": "table",
      "min_rows": 0,
      "description": "Master lncRNA-only table (annotated + novel), the lncRNA subset of catalog_genes.tsv. Same schema; use it instead of catalog_genes.tsv when only the lncRNAs are wanted (Excel, IP questions).",
      "columns": [
        {"name": "gene_id", "type": "string"},
        {"name": "gene_group", "type": "string"},
        {"name": "origin", "type": "string"},
        {"name": "class_code", "type": "string"},
        {"name": "tier", "type": "string"},
        {"name": "tier_final", "type": "string"},
        {"name": "lnc_position_class", "type": "string"},

// F4.6 / F4.7: publish run metadata and the contract-derived README.
// Writes the audit set (params_used, versions, sample_index, run_manifest,
// external_catalogs) and the run QA report, plus the two generated READMEs.
// The audit files go to <outdir>/run_info/ (pattern-scoped in conf/modules.config);
// versions/sample_index/qa_report/README go to <outdir>/deliverables[/run_info]/.

process PUBLISH_RUN_INFO {

    label 'process_single'

    input:
    path samples              // sample,norm_group,condition,batch TSV
    path strandedness         // CHECK_STRANDEDNESS strandedness_summary.tsv
    path versions_files       // collected versions.yml from every tool process
    path novelty_status       // CHECK_NOVELTY novelty_status.tsv
    path thresholds           // DERIVE_THRESHOLDS thresholds_used.tsv
    path gene_catalog         // BUILD_GENE_CATALOG gene_catalog.tsv
    path sensitivity          // COMPUTE_TIER_FINAL tier_final_sensitivity.tsv
    path qc_controls          // QC_CONTROLS qc_controls.tsv
    path universes            // all <group>_universe.tsv (catalog -> universe funnel)
    path coding_consensus     // CODING_CONSENSUS coding_consensus.tsv
    path recurrence           // EXPRESSION_RECURRENCE recurrence_filtered.tsv
    path length_offsets       // 2.1: per-group <group>_length_offset.txt (offset used?)
    path contract             // docs/deliverables_contract.json

    output:
    path "params_used.tsv"
    path "versions.tsv"
    path "sample_index.tsv", emit: sample_index
    path "run_manifest.tsv"
    path "external_catalogs.tsv"
    path "length_offset_used.tsv"
    path "__qc_controls.tsv"
    path "qa_report.tsv"
    path "funnel.tsv"
    path "__deliverables_README.md"
    path "__run_info_README.md"
    path "__raw_README.md"

    script:
    // Names come from docs/external_catalogs.json (single source); paths from params.
    def sources = new groovy.json.JsonSlurper()
        .parse(new File("${projectDir}/docs/external_catalogs.json"))['sources']
    def cats = sources.collect { s ->
        def path = params["${s.name}_bed"]
        path ? "--catalog ${s.name}=\"${path}\"".toString() : null
    }.findAll { it != null }
    def cat_args = cats.join(' ')
    def ver_args = versions_files.collect { "--versions-yml \"${it}\"" }.join(' ')
    // 4c.3: provenance is kept minimal and honest. git_sha/git_tag came out null
    // (not a git checkout in the run work dir), the container ":latest" tags are
    // mutable and carry no digest, and the cpat asset checksums were "unavailable".
    // The cheap, real signals stay: params_used, versions.tsv, nextflow_version,
    // session_id and which CPAT model ran.
    def cpat_model = (params.cpat_hexamer && params.cpat_logit_model) ? "stock_human" : "autogenerated_from_gtf"
    // H15: thresholds that shape the run, registered as explicit params_used rows.
    def extra_params = [
        'cpat_coding_threshold':          params.cpat_coding_threshold,
        'cpc2_coding_threshold':          params.cpc2_coding_threshold,
        'expression_recurrence_min_reps': params.expression_recurrence_min_reps,
        'recurrence_cpm_threshold':       params.recurrence_cpm_threshold,
        'min_transcript_length':          params.min_transcript_length,
        'tximport_min_count':             params.tximport_min_count,
        'cis_window':                     params.cis_window,
        'cis_normalize':                  params.cis_normalize,
        'cis_min_samples':                params.cis_min_samples,
        'cis_min_abs_rho':                params.cis_min_abs_rho,
        'tier1_allow_single_exon':        params.tier1_allow_single_exon,
        'extreme_basemean':               params.extreme_basemean,
        'shrink_type':                    'apeglm(ashr-fallback)',
    ].collect { k, v -> "--param \"${k}=${v}\"" }.join(' ')
    def manifest_entries = [
        'nextflow_version':           workflow.nextflow.version,
        'session_id':                 workflow.sessionId,
        'cpat_model':                 cpat_model,
    ].collect { k, v -> "--manifest-entry \"${k}=${v}\"" }.join(' ')
    def uni_args = universes.collect { "--universe \"${it}\"" }.join(' ')
    def off_args = length_offsets.collect { "--length-offset \"${it}\"" }.join(' ')
    """
    build_run_info.py \\
        --outdir . \\
        --samples "${samples}" \\
        --strandedness "${strandedness}" \\
        ${ver_args} \\
        --novelty-status "${novelty_status}" \\
        --thresholds "${thresholds}" \\
        --gene-catalog "${gene_catalog}" \\
        --sensitivity "${sensitivity}" \\
        --qc-controls "${qc_controls}" \\
        ${off_args} \\
        --pipeline-version "${workflow.manifest.version}" \\
        --publish-level "${params.publish_level}" \\
        --outdir-param "${params.outdir}" \\
        --species "${params.species}" \\
        --genome-build "${params.genome_build ?: ''}" \\
        --library-strandedness "${params.library_strandedness}" \\
        --design-formula "${params.design_formula}" \\
        --tier1-classes '${params.tier1_classes.join(",")}' \\
        --min-transcript-length "${params.min_transcript_length}" \\
        --fdr "${params.fdr_threshold}" \\
        --lfc "${params.lfc_threshold}" \\
        ${extra_params} \\
        ${manifest_entries} \\
        ${cat_args}

    build_funnel.py \\
        --gene-catalog "${gene_catalog}" \\
        ${uni_args} \\
        --coding-consensus "${coding_consensus}" \\
        --recurrence "${recurrence}" \\
        --novel-classes '${params.novel_classes.join(",")}' \\
        --isoform-classes '${params.isoform_classes.join(",")}' \\
        --outdir .

    build_deliverables_readme.py \\
        --contract "${contract}" \\
        --outdir . \\
        --deliverables-readme __deliverables_README.md \\
        --run-info-readme __run_info_README.md \\
        --raw-readme __raw_README.md \\
        --qa-report qa_report.tsv \\
        --publish-level "${params.publish_level}" \\
        --fdr "${params.fdr_threshold}" \\
        --lfc "${params.lfc_threshold}"
    """
}

/*
 * -------------------------------------------------
 *  lncRNA-nextflow Nextflow config
 * -------------------------------------------------
 */

manifest {
    name            = 'lncRNA-discovery'
    author          = 'BCI-KRP'
    homePage        = 'https://github.com/damouzo/lncRNA-nextflow'
    description     = 'Disease-agnostic lncRNA discovery, curation, and differential expression pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
    version         = '0.1.0'
}

// ==========================================================================
// Global defaults
// ==========================================================================

params {

    // ------------------------------------------------------------------
    // Input data — output from nf-core/rnaseq
    // ------------------------------------------------------------------
    input               = null
    genome              = null          // genome FASTA
    gtf                 = null          // reference GTF annotation
    gencode_transcripts_fa = null       // transcriptome FASTA for Salmon index (derived from GTF if unset)
    star_index          = null          // STAR index dir (optional)

    // ------------------------------------------------------------------
    // Experimental design
    // ------------------------------------------------------------------
    contrasts           = null          // CSV: contrast_name,numerator,denominator,batch
    design_formula      = null          // R formula for DESeq2 (e.g. '~ batch + condition')

    // ------------------------------------------------------------------
    // Discovery thresholds
    // ------------------------------------------------------------------
    min_transcript_length           = 200
    expression_recurrence_min_reps  = 3
    cpat_coding_threshold           = 0.364   // Coding probability cutoff for CPAT non-coding calls
    antisense_pct_threshold         = 95
    monoexonic_intron_ratio         = 0.3

    // ------------------------------------------------------------------
    // Quantification & statistics thresholds
    // ------------------------------------------------------------------
    cis_window          = 100000        // +/- bp window for cis-regulatory search
    fdr_threshold       = 0.05
    lfc_threshold       = 0.0

    // ------------------------------------------------------------------
    // External tool models
    // ------------------------------------------------------------------
    cpat_hexamer        = null          // CPAT hexamer table (auto-generated from GTF if unset)
    cpat_logit_model    = null          // CPAT logit model (auto-generated if unset)
    salmon_libtype      = null          // Override Salmon library type (SF, SR)
    featurecounts_strandness = 2        // 0=unstranded, 1=stranded, 2=reversely-stranded (dUTP)

    // ------------------------------------------------------------------
    // Reference lncRNA catalogs — reporting only, never a filter
    // ------------------------------------------------------------------
    noncode_bed         = null
    lncipedia_bed       = null
    rnacentral_bed      = null
    fantomcat_bed       = null

    // ------------------------------------------------------------------
    // Container overrides — default to GHCR images built by build-containers.yml
    // Override via env var or --<name>_container flag
    // ------------------------------------------------------------------
    discovery_container       = System.getenv('DISCOVERY_CONTAINER')       ?: null
    coding_potential_container = System.getenv('CODING_POTENTIAL_CONTAINER') ?: null
    r_bioc_container          = System.getenv('R_BIOC_CONTAINER')           ?: null

    // ------------------------------------------------------------------
    // HPC / SLURM
    // ------------------------------------------------------------------
    slurm_queue               = null
    slurm_account             = null
    max_memory                = '128.GB'
    max_cpus                  = 16
    max_time                  = '240.h'

    // ------------------------------------------------------------------
    // Execution
    // ------------------------------------------------------------------
    outdir              = 'results'
    publish_dir_mode    = 'copy'

    // Boilerplate
    help                = false
    validate_params     = true
}

// ==========================================================================
// Load base and module configs
// ==========================================================================
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// ==========================================================================
// Container defaults — resolved after profiles are applied
// ==========================================================================

// GHCR registry base for auto-built containers
def ghcr_base = 'ghcr.io/damouzo/lncrna-nextflow'

docker.registry = 'ghcr.io'

process {

    withName: 'BAM_QUICKCHECK|INFER_STRANDEDNESS|STRINGTIE2_PER_SAMPLE|STRINGTIE2_MERGE|GFFCOMPARE|TRANSCRIPT_LENGTH_FILTER|BUILD_DECOY_INDEX|SALMON_QUANTIFY|FEATURECOUNTS_EXPRESSION' {
        container = params.discovery_container ?: "${ghcr_base}/discovery:latest"
    }

    withName: 'CPAT_BUILD_MODEL|CPAT|CPC2' {
        container = params.coding_potential_container ?: "${ghcr_base}/coding_potential:latest"
    }

    withName: 'SPLIT_BY_NORMGROUP|CODING_CONSENSUS|CATALOG_OVERLAP|EXPRESSION_RECURRENCE|ANNOTATION_FREEZE|TXIMPORT_AND_FILTER|DESEQ2_DE|CIS_ASSOCIATIONS|FUNCTIONAL_ENRICHMENT' {
        container = params.r_bioc_container ?: "${ghcr_base}/r_bioc:latest"
    }

}

// ==========================================================================
// Profiles
// ==========================================================================
profiles {

    // ---- Docker (local workstation) ----
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        apptainer.enabled      = false
        executor {
            name      = 'local'
            cpus      = 16
            memory    = '48 GB'
            queueSize = 4
        }
    }

    // ---- Apptainer (HPC / clusters) ----
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        docker.enabled         = false
        singularity.enabled    = false
        executor {
            name      = 'local'
            cpus      = 16
            memory    = '48 GB'
            queueSize = 4
        }
    }

    // ---- Singularity (legacy HPC) ----
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        apptainer.enabled      = false
        executor {
            name      = 'local'
            cpus      = 16
            memory    = '48 GB'
            queueSize = 4
        }
    }

    // ---- Laptop / low-memory ----
    laptop {
        includeConfig 'conf/laptop.config'
    }

    // ---- SLURM (generic HPC cluster) ----
    slurm {
        includeConfig 'conf/slurm.config'
    }

    // ---- Apocrita HPC (QMUL) ----
    apocrita {
        includeConfig 'conf/apocrita.config'
    }

    // ---- Test ----
    test {
        includeConfig 'conf/test.config'
    }

}

// ==========================================================================
// Runtime environment
// ==========================================================================

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

timeline.enabled    = false
report.enabled      = false
dag.enabled         = false
trace.enabled       = false
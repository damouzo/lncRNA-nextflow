manifest {
    name        = 'lncRNA-discovery'
    version     = '0.1.0'
    description = 'Disease-agnostic lncRNA discovery, curation, and differential expression pipeline'
    author      = 'BCI-KRP'
    homePage    = 'https://github.com/BCI-KRP/lncRNA-nextflow'
}

params {

    // ------------------------------------------------------------------
    // Input data — output from nf-core/rnaseq
    // ------------------------------------------------------------------
    input               = null
    // CSV columns: sample,condition,batch,fastq_1,fastq_2,bam[,covariate_1,covariate_2,...]
    //   sample      : unique sample ID
    //   condition   : experimental condition (used in contrasts)
    //   batch       : batch / cell-type / normalization group (used in DESeq2 formula)
    //   fastq_1/2   : original FASTQ paths (for Salmon requantification)
    //   bam          : genome-coordinate sorted BAM (from nf-core/rnaseq star_salmon)
    //   Extra columns are treated as covariates and can be referenced in design_formula.
    //   See: assets/samplesheet_template.csv

    // ------------------------------------------------------------------
    // Reference genome & annotation
    // ------------------------------------------------------------------
    genome              = null          // genome FASTA (e.g. Homo_sapiens.GRCh38.dna_sm.primary_assembly.fa)
    gtf                 = null          // reference GTF annotation (e.g. Homo_sapiens.GRCh38.115.gtf)
    gencode_transcripts_fa = null       // GENCODE/Ensembl transcriptome FASTA for Salmon index
                                        // If unset, will be derived from $gtf + $genome via gffread
    star_index          = null          // STAR index dir (optional, for StringTie2 --ref guided mode)

    // ------------------------------------------------------------------
    // Experimental design
    // ------------------------------------------------------------------
    contrasts           = null
    // CSV columns: contrast_name, numerator, denominator[, batch]
    //   contrast_name : label for output files (e.g. KO_vs_WT)
    //   numerator     : condition level in the numerator
    //   denominator   : condition level in the denominator (reference)
    //   batch         : optional — restrict contrast to this batch value
    //   See: assets/contrasts_template.csv

    design_formula      = null          // R formula for DESeq2 (e.g. '~ batch + condition')

    // ------------------------------------------------------------------
    // Discovery thresholds (formerly Phase A)
    // ------------------------------------------------------------------
    min_transcript_length           = 200   // minimum summed exon length (nt)
    expression_recurrence_min_reps  = 3     // minimum biological replicates with expression support
    antisense_pct_threshold         = 95    // top N% expression percentile for antisense risk flag
    monoexonic_intron_ratio         = 0.3   // intron-coverage ratio threshold for monoexonic risk flag

    // ------------------------------------------------------------------
    // Quantification & statistics thresholds (formerly Phase B)
    // ------------------------------------------------------------------
    cis_window          = 100000        // ±bp window for cis-regulatory search
    fdr_threshold       = 0.05          // FDR threshold for significance
    lfc_threshold       = 0.0           // minimum biological LFC (0 = no threshold test)

    // ------------------------------------------------------------------
    // External tool models & databases
    // ------------------------------------------------------------------
    cpat_hexamer        = null          // CPAT hexamer frequency table (e.g. Human_Hexamer.tsv)
                                        // If unset, auto-generated from the reference GTF via CPAT_BUILD_MODEL
    cpat_logit_model    = null          // CPAT logistic regression model (e.g. Human_logitModel.RData)
                                        // If unset, auto-generated from the reference GTF via CPAT_BUILD_MODEL
    salmon_libtype      = null          // Override Salmon library type (SF, SR).
                                        // If unset, uses empirical detection from RSeQC infer_experiment.

    // ------------------------------------------------------------------
    // Reference lncRNA catalogs — reporting only, never a filter
    // ------------------------------------------------------------------
    noncode_bed         = null          // NONCODE lncRNA BED
    lncipedia_bed       = null          // LNCipedia BED
    rnacentral_bed      = null          // RNAcentral BED
    fantomcat_bed       = null          // FANTOM CAT BED

    // ------------------------------------------------------------------
    // Execution
    // ------------------------------------------------------------------
    outdir              = 'results'
    publish_dir_mode    = 'copy'
    tracedir            = "${params.outdir}/pipeline_info"
}

profiles {
    standard {
        includeConfig 'conf/base.config'
        includeConfig 'conf/modules.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

// Plugin & scope config
timeline.enabled     = true
report.enabled       = true
dag.enabled          = true
trace.enabled        = true

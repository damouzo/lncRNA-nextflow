/*
 * -------------------------------------------------
 *  lncRNA-nextflow Nextflow config
 * -------------------------------------------------
 */

manifest {
    name            = 'lncRNA-discovery'
    author          = 'BCI-KRP'
    homePage        = 'https://github.com/damouzo/lncRNA-nextflow'
    description     = 'Disease-agnostic lncRNA discovery, curation, and differential expression pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
    version         = '0.1.0'
}

// ==========================================================================
// Global defaults
// ==========================================================================

params {

    // ------------------------------------------------------------------
    // Input data — output from nf-core/rnaseq
    // ------------------------------------------------------------------
    input               = null
    genome              = null          // genome FASTA
    gtf                 = null          // reference GTF annotation
    gencode_transcripts_fa = null       // transcriptome FASTA for Salmon index (derived from GTF if unset)

    // ------------------------------------------------------------------
    // Experimental design
    // ------------------------------------------------------------------
    contrasts           = null          // CSV: contrast_name,numerator,denominator,batch
    design_formula      = null          // R formula for DESeq2 (e.g. '~ batch + condition')

    // ------------------------------------------------------------------
    // Discovery thresholds
    // ------------------------------------------------------------------
    min_transcript_length           = 200
    expression_recurrence_min_reps  = 3
    cpat_coding_threshold           = 0.364   // Coding probability cutoff for CPAT non-coding calls

    // Biotypes treated as "annotated lncRNA" when building the gene catalog
    // Ensembl >=107 consolidates them under a single 'lncRNA' biotype;
    // GENCODE releases use multiple (lincRNA, antisense, sense_intronic, ...).
    annotated_lncrna_biotypes = ['lncRNA']

    // ---- Tier 1 definition (categorical: class + parent biotype + exon count) ----
    tier1_classes  = ['u', 'x', 'i', 'j', 'o']
    tier1a_classes = ['u', 'x', 'i']   // novel_type 1a; j/o are 1b only when the parent gene is not protein_coding
    tier1_parent_biotypes = ['lncRNA'] // j/o parent biotype whitelist; pseudogenes/TEC/small-RNA hosts -> Tier 2
    // Categorical mono-exonic rule (no derived threshold). By default a mono-exonic
    // transcript of any class is demoted to Tier 2 and marked
    // `single_exon_low_confidence`; set true to keep mono-exonic transcripts in Tier 1.
    tier1_allow_single_exon = false

    // ---- F1.3/F1.4 flag metrics and derived thresholds ----
    // F1.3 (mono-exonic flank coverage) is EXPLORATORY and disabled by default: it
    // did not pass its pre-specified control separation (neg_flank rejection 0.135
    // < 0.90). The code is kept so a future dataset can re-evaluate it, but it does
    // NOT gate tier_final. The categorical mono-exonic rule above replaces it.
    run_flank_check      = false
    f1_flank_bp          = 2000    // +/- bp flank window around mono-exonic candidates
    f1_min_flank_len     = 200     // min unmasked flank length; shorter -> NA
    f1_control_cap       = 2000    // max elements per control set
    f1_seed              = 42      // deterministic control sampling
    f1_min_reads         = 10      // min same-strand reads for a sample to be used
    f1_min_controls      = 100     // min elements for a control set to trust its threshold
    f1_neg_reject_min    = 0.90    // min neg_flank rejection rate at the derived flank threshold
    f1_flank_percentile     = 10   // flank threshold = this percentile of pos_flank
    f1_antisense_percentile = 95   // antisense threshold = this percentile of null_antisense
    // Max fraction of pos_antisense flagged at the derived antisense threshold before
    // the threshold is reported as not specific (diagnostic; does not change the value).
    f1_antisense_pos_flag_max = 0.30
    // Overrides (take priority when set); defaults are the fallback if controls are unreliable
    flank_ratio_threshold     = null
    antisense_ratio_threshold = null
    flank_ratio_default       = 2.0
    antisense_ratio_default   = 0.15

    // ------------------------------------------------------------------
    // Quantification & statistics thresholds
    // ------------------------------------------------------------------
    cis_window          = 100000        // +/- bp window for cis-regulatory search
    fdr_threshold       = 0.05
    lfc_threshold       = 1.0
    report_template     = null          // optional Quarto template for the reporting engine

    // Expression-heterogeneity diagnostic (Carrasco-Leon et al. 2021), complementary to
    // DESeq2 — opt-in per norm_group, default false for any group not listed here.
    heterogeneity_analysis = [:]
    heterogeneity_concordant_frac = 0.50   // min fraction of case samples agreeing on direction to call a gene "altered"
    heterogeneity_discordant_frac = 0.25   // max fraction of case samples allowed in the opposite direction

    // ------------------------------------------------------------------
    // External tool models
    // ------------------------------------------------------------------
    cpat_hexamer        = null          // CPAT hexamer table (auto-generated from GTF if unset)
    cpat_logit_model    = null          // CPAT logit model (auto-generated if unset)
    salmon_index_sparse = true          // Build a sparse Salmon index (lower peak RAM for large gentromes)

    // ------------------------------------------------------------------
    // Library strandedness — single contract shared by Salmon, featureCounts
    // and StringTie (see lib/Strandedness.groovy). reverse = fr-firststrand
    // (dUTP/Illumina), the usual RNA-seq case.
    // ------------------------------------------------------------------
    library_strandedness = 'reverse'   // reverse | forward | unstranded
    salmon_libtype      = null          // OPTIONAL override; must match the contract if set
    featurecounts_strandness = null     // OPTIONAL override; must match the contract if set

    // Strandedness guards (Phase A / post-quantification)
    strandedness_min_fidelity = 0.70    // E/(E+O); observed 0.80-0.89 in the pilot cohort
    strandedness_guard_strict = false   // true turns a low-fidelity warning into a hard failure
    salmon_min_compat_ratio   = 0.70    // hard floor for compatible_fragment_ratio (below -> fail)
    salmon_min_orientation_ratio = 0.70 // hard: declared/(declared+opposite) in lib_format_counts

    // ------------------------------------------------------------------
    // Reference lncRNA catalogs — reporting only, never a filter
    // ------------------------------------------------------------------
    noncode_bed         = null
    lncipedia_bed       = null
    rnacentral_bed      = null
    fantomcat_bed       = null

    // ------------------------------------------------------------------
    // Stable catalog identity (novel lncRNA registry) — Phase A
    // catalog_registry: persistent TSV OUTSIDE results/ (null = feature off).
    // Passed internally as a `val` (not file(checkIfExists:true)) so a missing
    // registry on the first run does not fail path resolution.
    // ------------------------------------------------------------------
    catalog_registry                = null   // persistent two-level registry, outside results/
    catalog_registry_project        = null   // provenance label (e.g. CRUK_DDX41_DHX34)
    catalog_registry_allow_cross_project = false  // allow extending a registry that belongs to a different project label
    catalog_registry_min_reciprocal = 0.5    // match gen/transcrito against the registry
    catalog_id_prefix               = 'LNC'  // catalog ID prefix (gene level)
    external_catalog_min_reciprocal = 0.5    // strict hit call against external catalogs

    // ------------------------------------------------------------------
    // Species / build metadata — descriptive + guards that external
    // conservation/synteny resources match params.genome. Species-agnostic:
    // nothing species-specific is hardcoded; these values surface in report
    // labels/logs and validate that external references share the assembly.
    // ------------------------------------------------------------------
    species              = 'human'   // free-form label, report/logs only
    genome_build         = null      // e.g. 'GRCh38.p14' — REQUIRED if any
                                     // conservation_bigwig or synteny_chain_file is set

    // ---- Sequence conservation — reporting only, same contract as catalog_overlap ----
    conservation_bigwig     = null   // local path to phastCons/phyloP/GERP bigWig
    conservation_metric     = 'phastCons'   // label only, surfaces in the report
    conservation_min_score  = 0.5    // cutoff ONLY for the pct_bases_conserved
                                     // report column, never filters transcripts

    // ---- Synteny — reporting only ----
    synteny_chain_file      = null   // liftOver chain file, source build -> target build
    synteny_target_species  = null   // label + validation, e.g. 'mouse'
    synteny_target_gtf      = null   // annotated GTF of the target species

    // ------------------------------------------------------------------
    // Container overrides — default to GHCR images built by build-containers.yml
    // Override via env var or --<name>_container flag
    // ------------------------------------------------------------------
    discovery_container       = System.getenv('DISCOVERY_CONTAINER')       ?: null
    coding_potential_container = System.getenv('CODING_POTENTIAL_CONTAINER') ?: null
    r_bioc_container          = System.getenv('R_BIOC_CONTAINER')           ?: null
    reporting_container       = System.getenv('REPORTING_CONTAINER')         ?: null

    // ------------------------------------------------------------------
    // HPC / SLURM
    // ------------------------------------------------------------------
    slurm_queue               = null
    slurm_account             = null
    max_memory                = '128.GB'
    max_cpus                  = 16
    max_time                  = '240.h'

    // ------------------------------------------------------------------
    // Execution
    // ------------------------------------------------------------------
    outdir              = 'results'
    publish_dir_mode    = 'copy'
    // How much of the run tree is published (see "Mapa de publicación" in the plan):
    //   core     -> deliverables/ only
    //   core_raw -> deliverables/ + raw/ + run_info/
    //   full     -> the above plus heavy audit outputs (bam_validation, strandedness_bed)
    publish_level       = 'core_raw'
    // Slice D: optional xlsx export of the per-contrast DE tables (TSV stays the source).
    export_xlsx         = false
    // F3.2: per-contrast design rank check -> fail (default) aborts, warn records.
    design_check        = 'fail'
    // F3.1: normalize cis associations (VST + removeBatchEffect) before Spearman.
    cis_normalize       = true
    // F5.1: catalog figures (non-blocking).
    run_figures         = true

    // Boilerplate
    help                = false
    validate_params     = true
}

// ==========================================================================
// Load base and module configs
// ==========================================================================
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// ==========================================================================
// Container defaults — resolved after profiles are applied
// ==========================================================================

docker.registry = 'ghcr.io'

process {

    withName: 'BAM_QUICKCHECK|INFER_STRANDEDNESS|STRINGTIE2_PER_SAMPLE|STRINGTIE2_MERGE|GFFCOMPARE|TRANSCRIPT_LENGTH_FILTER|BUILD_DECOY_INDEX|SALMON_QUANTIFY|CHECK_SALMON_LIBTYPE|FEATURECOUNTS_EXPRESSION|CHECK_REFERENCE_COMPATIBILITY|CONSERVATION_SCORE|SYNTENY_CHECK|BUILD_F1_REGIONS|FLANK_COUNTS|FLANK_COVERAGE_RATIO|ANTISENSE_COUNTS|FLAG_ANTISENSE_LEAKAGE|DERIVE_THRESHOLDS|COMPUTE_TIER_FINAL|PUBLISH_CATALOG|CHECK_NOVELTY|PUBLISH_RUN_INFO|RECOVERY_CHECK|VERSION_DISCOVERY|SPLIT_ENRICHMENT|BUILD_CONTRASTS_OVERVIEW|CHECK_DELIVERABLES' {
        container = params.discovery_container ? "${params.discovery_container}" : 'ghcr.io/damouzo/lncrna-nextflow/discovery:latest'
    }

    withName: 'CPAT_BUILD_MODEL|CPAT|CPC2|VERSION_CODING' {
        container = params.coding_potential_container ? "${params.coding_potential_container}" : 'ghcr.io/damouzo/lncrna-nextflow/coding_potential:latest'
    }

    withName: 'SPLIT_BY_NORMGROUP|CODING_CONSENSUS|CATALOG_OVERLAP|EXPRESSION_RECURRENCE|ANNOTATION_FREEZE|BUILD_GENE_CATALOG|ASSIGN_CATALOG_IDS|BUILD_CATALOG_MASTER|BUILD_INFER_BED|CHECK_STRANDEDNESS|TXIMPORT_AND_FILTER|DESEQ2_DE|CIS_ASSOCIATIONS|FUNCTIONAL_ENRICHMENT|HETEROGENEITY_ANALYSIS|SPLIT_CONTRASTS|MAKE_XLSX|BUILD_CONTRAST_TABLES|DESIGN_CHECK' {
        container = params.r_bioc_container ? "${params.r_bioc_container}" : 'ghcr.io/damouzo/lncrna-nextflow/r_bioc:latest'
    }

    withName: 'REPORT_CONTRAST|FIGURES' {
        container = params.reporting_container ? "${params.reporting_container}" : 'ghcr.io/damouzo/lncrna-nextflow/reporting:latest'
    }

}

// ==========================================================================
// Profiles
// ==========================================================================
profiles {

    // ---- Docker (local workstation) ----
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        apptainer.enabled      = false
        executor {
            name      = 'local'
            cpus      = 16
            memory    = 48.GB
            queueSize = 4
        }
    }

    // ---- Apptainer (HPC / clusters) ----
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        docker.enabled         = false
        singularity.enabled    = false
        executor {
            name      = 'local'
            cpus      = 16
            memory    = 48.GB
            queueSize = 4
        }
    }

    // ---- Laptop / low-memory ----
    laptop {
        includeConfig 'conf/laptop.config'
    }

    // ---- SLURM (generic HPC cluster) ----
    slurm {
        includeConfig 'conf/slurm.config'
    }

    // ---- Apocrita HPC (QMUL) ----
    apocrita {
        includeConfig 'conf/apocrita.config'
    }

    // ---- Test ----
    test {
        includeConfig 'conf/test.config'
    }

}

// ==========================================================================
// Runtime environment
// ==========================================================================

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

// Run traceability. overwrite=true lets a re-run of the same outdir succeed
// instead of failing on existing files (F0.3 validation). Pipeline artifacts land
// under deliverables/run_info/pipeline_info (Mapa de publicación).
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/deliverables/run_info/pipeline_info/execution_trace.txt"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/deliverables/run_info/pipeline_info/execution_report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/deliverables/run_info/pipeline_info/execution_timeline.html"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/deliverables/run_info/pipeline_info/execution_dag.html"
}